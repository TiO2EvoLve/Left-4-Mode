<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.5" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Downloader" Version="6.0.1" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
        <PackageReference Include="SukiUI" Version="7.0.1" />
        <PackageReference Include="ValveKeyValue" Version="0.80.0.542" />
        <PackageReference Include="ValvePak" Version="7.2.0.221" />
    </ItemGroup>
</Project>
