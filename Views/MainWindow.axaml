<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Left_4_Mod.ViewModels"
                   xmlns:models="using:Left_4_Mod.Models"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                   mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="700"
                   x:Class="Left_4_Mod.Views.MainWindow"
                   x:DataType="vm:MainViewModel"
                   Title="L4D2 Mod 管理器"
                   Width="1120" Height="700"
                   MinWidth="900" MinHeight="540"
                   WindowStartupLocation="CenterScreen"
                   Icon="/Assets/avalonia-logo.ico"
                   CanPin="True"
                   CanFullScreen="True"
                   ShowBottomBorder="True"
                   IsMenuVisible="False">

    <sukiUi:SukiWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="AppToolbarBackground" Color="#FBFAFC" />
                    <SolidColorBrush x:Key="AppContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppStatusBackground" Color="#F7F7F9" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E3E3E8" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#6B6B76" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0F6CBD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="AppToolbarBackground" Color="#FBFAFC" />
                    <SolidColorBrush x:Key="AppContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppStatusBackground" Color="#F7F7F9" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E3E3E8" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#6B6B76" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0F6CBD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="AppToolbarBackground" Color="#232327" />
                    <SolidColorBrush x:Key="AppContentBackground" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="AppStatusBackground" Color="#202024" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#34343A" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#A0A0AA" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#4CC2FF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </sukiUi:SukiWindow.Resources>

    <sukiUi:SukiWindow.Styles>
        <Style Selector="ListBoxItem /template/ PathIcon#CheckSelected">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Button.columnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.filter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.breadcrumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.viewMode">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.viewMode.selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </sukiUi:SukiWindow.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource AppWindowBackground}">

        <!-- ================= 顶部：只保留搜索 ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppToolbarBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <TextBox x:Name="SearchBox"
                     IsEnabled="{Binding HasLibrary}"
                     FontSize="13"
                     MinHeight="36"
                     PlaceholderText="搜索模组名称、文件名或分组…"
                     TextChanged="OnSearchTextChanged"
                     KeyDown="OnSearchKeyDown">
                <TextBox.InnerRightContent>
                    <Button x:Name="FilterButton"
                            Classes="filter"
                            IsEnabled="{Binding HasLibrary}"
                            ToolTip.Tip="筛选：分组 / 启用状态 / 部署状态">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    Opened="OnFilterFlyoutOpened"
                                    Closed="OnFilterFlyoutClosed">
                                <Border x:Name="FilterPanel"
                                        Width="330"
                                        Padding="16"
                                        CornerRadius="8"
                                        Background="{DynamicResource AppContentBackground}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        KeyDown="OnFilterPanelKeyDown">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="筛选模组" FontWeight="SemiBold" />

                                        <TextBlock Text="启用状态" FontSize="12" Classes="secondary" />
                                        <ComboBox SelectedIndex="{Binding EnabledFilterIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="全部状态" />
                                            <ComboBoxItem Content="已启用" />
                                            <ComboBoxItem Content="未启用" />
                                        </ComboBox>

                                        <TextBlock Text="部署状态" FontSize="12" Classes="secondary" />
                                        <ComboBox SelectedIndex="{Binding DeploymentFilterIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="全部部署状态" />
                                            <ComboBoxItem Content="已部署" />
                                            <ComboBoxItem Content="未部署" />
                                        </ComboBox>

                                        <Button Content="清除全部筛选"
                                                HorizontalAlignment="Right"
                                                Click="OnClearFiltersClick" />
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <materialIcons:MaterialIcon Kind="FilterVariant" IconSize="18" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </Border>

        <!-- ================= 导航与面包屑 ================= -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasLibrary}"
                Background="{DynamicResource AppToolbarBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button Classes="flat" Click="OnNavigateBackClick"
                            IsEnabled="{Binding CanNavigateBack}" ToolTip.Tip="后退">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" IconSize="18" />
                    </Button>
                    <Button Classes="flat" Click="OnNavigateForwardClick"
                            IsEnabled="{Binding CanNavigateForward}" ToolTip.Tip="前进">
                        <materialIcons:MaterialIcon Kind="ArrowRight" IconSize="18" />
                    </Button>
                    <Button Classes="flat" Click="OnNavigateUpClick"
                            IsEnabled="{Binding CanNavigateUp}" ToolTip.Tip="上一级">
                        <materialIcons:MaterialIcon Kind="ArrowUp" IconSize="18" />
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="10,0,10,0">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BreadcrumbItem">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="breadcrumb"
                                            Content="{Binding Name}"
                                            Tag="{Binding RelativePath}"
                                            IsEnabled="{Binding !IsLast}"
                                            Click="OnBreadcrumbClick" />
                                    <TextBlock Text="›"
                                               IsVisible="{Binding ShowSeparator}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Classes="secondary" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Classes="viewMode"
                            Classes.selected="{Binding IsDetailsView}"
                            Click="OnDetailsViewClick"
                            ToolTip.Tip="详细信息">
                        <materialIcons:MaterialIcon Kind="ViewList" IconSize="18" />
                    </Button>
                    <Button Classes="viewMode"
                            Classes.selected="{Binding IsLargeIconsView}"
                            Click="OnLargeIconsViewClick"
                            ToolTip.Tip="大图标">
                        <materialIcons:MaterialIcon Kind="ViewGrid" IconSize="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 列头 ================= -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowDetailsHeader}"
                Background="{DynamicResource AppContentBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0"
                Height="34">
            <Grid ColumnDefinitions="36,*,120,90,140,130">
                <Button Grid.Column="1"
                        Classes="columnHeader"
                        Content="{Binding NameHeader}"
                        Click="OnSortNameClick" />
                <TextBlock Grid.Column="2"
                           Text="类型"
                           FontSize="12"
                           Margin="4,0"
                           VerticalAlignment="Center"
                           Classes="secondary" />
                <Button Grid.Column="3" Classes="columnHeader" Content="{Binding SizeHeader}"
                        HorizontalAlignment="Right" HorizontalContentAlignment="Right" Margin="0,0,14,0"
                        Click="OnSortSizeClick" />
                <Button Grid.Column="4" Classes="columnHeader" Content="{Binding ModifiedHeader}" Margin="8,0,0,0" Click="OnSortModifiedClick" />
                <TextBlock Grid.Column="5"
                           Text="状态"
                           FontSize="12"
                           Margin="4,0"
                           VerticalAlignment="Center"
                           Classes="secondary" />
            </Grid>
        </Border>

        <!-- ================= 模组列表 ================= -->
        <Grid Grid.Row="3" Background="{DynamicResource AppContentBackground}">
            <ListBox x:Name="ModList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     IsEnabled="{Binding CanModify}"
                     IsVisible="{Binding IsDetailsView}"
                     SelectionMode="Multiple"
                     ItemsSource="{Binding Rows}"
                     SelectionChanged="OnModSelectionChanged"
                     DoubleTapped="OnFileListDoubleTapped">
                <ListBox.ContextMenu>
                    <ContextMenu Opening="OnContextMenuOpening"
                                 Closed="OnContextMenuClosed"
                                 KeyDown="OnContextMenuKeyDown">
                        <MenuItem Header="启用选中模组" Tag="enable" Click="OnEnableSelectedClick" />
                        <MenuItem Header="禁用选中模组" Tag="disable" Click="OnDisableSelectedClick" />
                        <Separator />
                        <MenuItem Header="重命名…" Tag="rename" Click="OnRenameSelectedClick" />
                        <MenuItem Header="移动到文件夹…" Tag="move" Click="OnMoveSelectedClick" />
                        <MenuItem Header="删除模组…" Tag="delete" Click="OnDeleteSelectedClick" />
                        <Separator />
                        <MenuItem Header="删除文件夹…（含内容）" Tag="deletefolder" Click="OnDeleteFolderClick" />
                        <Separator />
                        <MenuItem Header="新建文件夹…" Tag="newfolder" Click="OnNewFolderClick" />
                        <Separator />
                        <MenuItem Header="在资源管理器中显示" Tag="reveal" Click="OnRevealInExplorerClick" />
                        <MenuItem Header="刷新" Tag="refresh" Click="OnRefreshClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FileRow">
                        <Grid Height="36"
                              Margin="8,0"
                              ColumnDefinitions="36,*,120,90,140,130">
                            <CheckBox Grid.Column="0"
                                      IsVisible="{Binding ShowCheckBox}"
                                      IsChecked="{Binding Mod.IsEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="启用/禁用该模组（推送后同步到游戏）" />

                            <Grid Grid.Column="1"
                                  ColumnDefinitions="Auto,*"
                                  Margin="0,0,12,0">
                                <Image Grid.Column="0"
                                       Source="{Binding Thumbnail}"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ToolTip}" />
                            </Grid>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding TypeText}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Classes="secondary" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" Classes="secondary" />
                            <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" Classes="secondary" />
                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding ToolTip}">
                                <materialIcons:MaterialIcon Kind="{Binding Mod.StatusIcon}"
                                                            IsVisible="{Binding !IsFolder}"
                                                            IconSize="15"
                                                            VerticalAlignment="Center" />
                                <materialIcons:MaterialIcon Kind="{Binding StatusIcon}"
                                                            IsVisible="{Binding IsFolder}"
                                                            IconSize="15"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Mod.StatusText}"
                                           IsVisible="{Binding !IsFolder}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Classes="secondary" />
                                <TextBlock Text="{Binding StatusText}"
                                           IsVisible="{Binding IsFolder}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Classes="secondary" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="IconList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6"
                     IsEnabled="{Binding CanModify}"
                     IsVisible="{Binding IsLargeIconsView}"
                     SelectionMode="Multiple"
                     ItemsSource="{Binding Rows}"
                     SelectionChanged="OnModSelectionChanged"
                     DoubleTapped="OnFileListDoubleTapped">
                <ListBox.ContextMenu>
                    <ContextMenu Opening="OnContextMenuOpening"
                                 Closed="OnContextMenuClosed"
                                 KeyDown="OnContextMenuKeyDown">
                        <MenuItem Header="启用选中模组" Tag="enable" Click="OnEnableSelectedClick" />
                        <MenuItem Header="禁用选中模组" Tag="disable" Click="OnDisableSelectedClick" />
                        <Separator />
                        <MenuItem Header="重命名…" Tag="rename" Click="OnRenameSelectedClick" />
                        <MenuItem Header="移动到文件夹…" Tag="move" Click="OnMoveSelectedClick" />
                        <MenuItem Header="删除模组…" Tag="delete" Click="OnDeleteSelectedClick" />
                        <Separator />
                        <MenuItem Header="删除文件夹…（含内容）" Tag="deletefolder" Click="OnDeleteFolderClick" />
                        <Separator />
                        <MenuItem Header="新建文件夹…" Tag="newfolder" Click="OnNewFolderClick" />
                        <Separator />
                        <MenuItem Header="在资源管理器中显示" Tag="reveal" Click="OnRevealInExplorerClick" />
                        <MenuItem Header="刷新" Tag="refresh" Click="OnRefreshClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FileRow">
                        <Border Width="150"
                                Height="142"
                                Padding="8"
                                CornerRadius="6">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Row="0"
                                          IsVisible="{Binding ShowCheckBox}"
                                          IsChecked="{Binding Mod.IsEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          ToolTip.Tip="启用/禁用该模组" />
                                <Image Grid.Row="1"
                                       Source="{Binding Thumbnail}"
                                       Width="76"
                                       Height="76"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="34"
                                               ToolTip.Tip="{Binding ToolTip}" />
                                    <TextBlock Text="{Binding Mod.StatusText}"
                                               IsVisible="{Binding !IsFolder}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               Classes="secondary"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}"
                                               IsVisible="{Binding IsFolder}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               Classes="secondary"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 未选择模组库 / 路径失效 -->
            <Border IsVisible="{Binding ShowWelcome}"
                    Background="{DynamicResource AppContentBackground}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="540">
                    <materialIcons:MaterialIcon Kind="FolderSearch"
                                                IconSize="72"
                                                Foreground="{DynamicResource AppAccentBrush}"
                                                HorizontalAlignment="Center" />
                    <TextBlock Text="选择一个模组库文件夹"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="选择后只显示库内的 .vpk 模组。启用状态保存在应用数据中，推送时再同步到游戏 addons 目录。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Classes="secondary" />
                    <TextBlock Text="{Binding Message}"
                               IsVisible="{Binding LibraryUnavailable}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#C42B1C" />
                    <Button Content="选择模组库文件夹"
                            Click="OnSelectLibraryClick"
                            HorizontalAlignment="Center"
                            Padding="18,8"
                            Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 模组库为空 -->
            <Border IsVisible="{Binding IsEmptyLibrary}"
                    Background="{DynamicResource AppContentBackground}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <materialIcons:MaterialIcon Kind="FileStar"
                                                IconSize="64"
                                                Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                HorizontalAlignment="Center" />
                    <TextBlock Text="模组库中没有 .vpk 模组"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="把 VPK 文件放进模组库，或使用“导入模组”按钮。"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                    <Button Content="导入模组"
                            Click="OnImportClick"
                            IsEnabled="{Binding CanImport}"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 当前文件夹为空 -->
            <Border IsVisible="{Binding IsCurrentFolderEmpty}"
                    Background="{DynamicResource AppContentBackground}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <materialIcons:MaterialIcon Kind="FolderOpen"
                                                IconSize="64"
                                                Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                HorizontalAlignment="Center" />
                    <TextBlock Text="此文件夹为空"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="使用“导入”添加 VPK，或新建文件夹。"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="导入模组"
                                Click="OnImportClick"
                                IsEnabled="{Binding CanImport}" />
                        <Button Content="新建文件夹"
                                Click="OnNewFolderClick"
                                IsEnabled="{Binding CanModify}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 筛选无结果 -->
            <Border IsVisible="{Binding HasNoResults}"
                    Background="{DynamicResource AppContentBackground}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <materialIcons:MaterialIcon Kind="Magnify"
                                                IconSize="56"
                                                Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NoResultsTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NoResultsHint}"
                               Classes="secondary"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="520"
                               HorizontalAlignment="Center" />
                    <Button Content="{Binding NoResultsActionText}"
                            Click="OnClearFiltersClick"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 底部状态与操作 ================= -->
        <Border Grid.Row="4"
                Background="{DynamicResource AppStatusBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  VerticalAlignment="Center">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="14"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModSummary}"
                               FontSize="12"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               Classes="secondary" />
                    <TextBlock Text="{Binding SelectionStatus}"
                               FontSize="12"
                               MaxWidth="110"
                               TextTrimming="CharacterEllipsis"
                               Classes="secondary" />
                    <TextBlock Text="{Binding FilterSummary}"
                               FontSize="12"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis"
                               Classes="secondary" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Click="OnImportClick" Classes="Flat" IsEnabled="{Binding CanImport}" ToolTip.Tip="从本地导入 .vpk 模组">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FilePlus" IconSize="16" />
                            <TextBlock Text="导入" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="flat" Click="OnNewFolderClick" IsEnabled="{Binding CanModify}" ToolTip.Tip="新建文件夹（用于分类）">
                        <materialIcons:MaterialIcon Kind="FolderPlus" Foreground="Orange" IconSize="18" />
                    </Button>
                    <Button Classes="flat" Click="OnWorkshopClick" IsEnabled="{Binding CanImport}" ToolTip.Tip="从创意工坊下载模组">
                        <materialIcons:MaterialIcon Kind="CloudDownload" Foreground="DodgerBlue" IconSize="18" />
                    </Button>
                    <Button Classes="flat" Click="OnCheckWorkshopUpdatesClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="检查创意工坊更新">
                        <materialIcons:MaterialIcon Kind="CloudRefresh" Foreground="LimeGreen" IconSize="18" />
                    </Button>
                    <Button Classes="flat" Click="OnRefreshClick" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="重新扫描模组库（F5）">
                        <materialIcons:MaterialIcon Kind="Refresh" Foreground="Gray" IconSize="18" />
                    </Button>
                    <Button Click="OnPushClick" Classes="Flat Success" IsEnabled="{Binding CanPush}" ToolTip.Tip="{Binding GameStatusText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Upload" IconSize="17" />
                            <TextBlock Text="推送到游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="flat" Click="OnSettingsClick" IsEnabled="{Binding CanOpenSettings}" ToolTip.Tip="设置">
                        <materialIcons:MaterialIcon Kind="Cog" IconSize="18" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      ColumnDefinitions="*,Auto"
                      Margin="0,2,0,0"
                      VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Message}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ClipToBounds="True"
                               ToolTip.Tip="{Binding Message}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Classes="secondary" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameStatusText}"
                                   IsVisible="{Binding !IsGameReady}"
                                   FontSize="12"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding GameStatusText}"
                                   Foreground="#C42B1C"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyText}"
                                   FontSize="12"
                                   MaxWidth="280"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding BusyText}"
                                   VerticalAlignment="Center"
                                   Classes="secondary"
                                   IsVisible="{Binding IsBusy}" />
                        <ProgressBar Width="110"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsBusy}" />
                        <Button Content="取消"
                                FontSize="11"
                                Padding="8,2"
                                Click="OnCancelOperationClick"
                                IsVisible="{Binding CanCancel}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</sukiUi:SukiWindow>
